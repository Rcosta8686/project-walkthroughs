# Copia este ficheiro para `.env` e preenche os valores.
# NUNCA faças commit do ficheiro `.env` — ele contém segredos.

# ─── API-Football (RapidAPI) ──────────────────────────────────────────
# Como obter: regista-te em https://rapidapi.com/api-sports/api/api-football
# Subscreve o plano Pro (~€29/mês), copia a tua chave aqui.
API_FOOTBALL_KEY=
API_FOOTBALL_HOST=api-football-v1.p.rapidapi.com

# ─── Telegram ─────────────────────────────────────────────────────────
# Como obter o TOKEN: fala com https://t.me/BotFather, escreve /newbot,
# segue as instruções e copia o token que ele devolve.
TELEGRAM_BOT_TOKEN=

# Como obter o CHAT_ID: fala com https://t.me/userinfobot e copia o
# número de ID que ele te envia.
TELEGRAM_CHAT_ID=

# ─── Modo de operação ────────────────────────────────────────────────
# "desenvolvimento" → só imprime no terminal, não envia Telegram real
# "producao"        → envia alertas reais
MODO=desenvolvimento
